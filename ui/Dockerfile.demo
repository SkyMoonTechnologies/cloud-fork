FROM node:24-bookworm AS build

WORKDIR /app

COPY package*.json ./
# The upstream CloudStack package-lock.json is v1 and out of sync with
# package.json (for example, axios). npm ci fails with EUSAGE; for this
# disposable UI demo, let npm reconcile the lockfile inside the image.
RUN npm install --legacy-peer-deps --no-audit --no-fund

COPY . .

ENV NODE_OPTIONS=--openssl-legacy-provider
RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist/ /usr/share/nginx/html/
COPY nginx/demo.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
